[Unit]
Description=Nexus Open — iCUE Nexus daemon (headless)
Documentation=https://github.com/mantonx/nexus-open
# For machines with no desktop session (SBCs, cluster nodes). Pair with
# packaging/udev/99-corsair-nexus-headless.rules, which grants the device to
# the plugdev group instead of the logged-in seat user.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/nexus-open
Restart=on-failure
RestartSec=5s
KillMode=mixed
TimeoutStopSec=10

# ── Identity & state ─────────────────────────────────────────────────────────
# Transient user; device access comes from the plugdev group via udev.
DynamicUser=yes
SupplementaryGroups=plugdev
StateDirectory=nexus-open
# The daemon resolves its DB, token and data dirs from XDG; point both at the
# state directory so nothing depends on a home directory.
Environment=XDG_CONFIG_HOME=%S/nexus-open/config
Environment=XDG_DATA_HOME=%S/nexus-open/data
Environment=NEXUS_PLUGINS_DIR=/usr/lib/nexus-open/plugins

# ── Privilege & execution hardening ──────────────────────────────────────────
NoNewPrivileges=true
LockPersonality=true
RestrictSUIDSGID=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

# ── Kernel & namespace hardening ─────────────────────────────────────────────
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true

# ── Device access ─────────────────────────────────────────────────────────────
DevicePolicy=closed
DeviceAllow=char-usb_device rwm

# ── Network & syscall restrictions ───────────────────────────────────────────
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
MemoryDenyWriteExecute=true
UMask=0077

[Install]
WantedBy=multi-user.target
